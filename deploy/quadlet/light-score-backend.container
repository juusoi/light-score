[Unit]
Description=Light Score Backend API
After=network-online.target light-score-network.service
Wants=network-online.target

[Container]
ContainerName=light-score-backend
Image=ghcr.io/juusoi/light-score-backend:latest
AutoUpdate=registry
Network=light-score.network
Environment=MOCK_ESPN=false
LogDriver=journald
HealthCmd=curl -f http://localhost:8000/health || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s
HealthOnFailure=kill
Notify=healthy

[Service]
TimeoutStartSec=60
Restart=on-failure

[Install]
WantedBy=default.target
