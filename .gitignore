# ─────────────────────────────────────────────────────────────────────────────
# Whitelist-style .gitignore
# Default: Ignore everything in root
# ─────────────────────────────────────────────────────────────────────────────
/*

# ─────────────────────────────────────────────────────────────────────────────
# Whitelist: Root configuration and project files
# ─────────────────────────────────────────────────────────────────────────────
!/.bandit
!/.dockerignore
!/.gitignore
!/.python-version
!/AGENTS.md
!/LICENSE
!/README.md
!/compose.prod.yaml
!/compose.yaml
!/justfile
!/pyproject.toml
!/uv.lock

# ─────────────────────────────────────────────────────────────────────────────
# Whitelist: Project directories
# ─────────────────────────────────────────────────────────────────────────────
!/.github/
!/backend/
!/deploy/
!/docs/
!/e2e/
!/frontend/
!/functions/
!/scripts/

# ─────────────────────────────────────────────────────────────────────────────
# Exclusions within whitelisted directories (caches, builds, dependencies)
# ─────────────────────────────────────────────────────────────────────────────
# Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.venv/
**/env/
**/venv/
**/*.egg-info/
**/build/
**/dist/
**/.coverage
**/.coverage.*
**/htmlcov/

# Node / Testing
**/node_modules/
**/playwright-report/
**/test-results/
**/.playwright-mcp/

# Local configuration, secrets, IDE, OS
**/.DS_Store
**/.env
**/.env.*
**/.vscode/
**/.idea/
**/.antigravitycli/
**/*.log
