{
  "name": "lightscore-e2e",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test tests/api/",
    "test:chrome": "playwright test --project=chrome",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:ci": "CI=true playwright test --project=chromium --project=api",
    "test:smoke": "CI=true playwright test --grep @smoke --project=chromium",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps",
    "lint": "eslint tests/ --ext .ts",
    "lint:fix": "eslint tests/ --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "fmt": "prettier --write tests/",
    "fmt:check": "prettier --check tests/",
    "ci": "pnpm run lint && pnpm run type-check"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^6.0.3",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4"
  }
}